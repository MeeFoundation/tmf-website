---
import {tellipodHome, tellipodPages, type TellipodPageId} from '../../tellipod';
import {themed} from '../../tellipod-theme';
import logo from '@assets/tellipod/tellipod-logo.svg';

export interface Props {
  current: TellipodPageId;
}

const {current} = Astro.props;
---

<div class="tp-container tp-strip">
  <a href={tellipodHome} aria-label="Tellipod home">
    <img {...themed(logo)} width={logo.width} height={logo.height} alt="Tellipod" />
  </a>
  <nav class="tp-strip__pages" aria-label="Tellipod">
    {
      tellipodPages.map((page, i) => (
        <>
          {i > 0 && <span class="tp-strip__sep" aria-hidden="true">·</span>}
          {page.id === current ? (
            <span aria-current="page">{page.name}</span>
          ) : (
            <a class="tp-link" href={page.href}>
              {page.name}
            </a>
          )}
        </>
      ))
    }
  </nav>
</div>

<style>
  .tp-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 156px;
  }
  .tp-strip img {
    width: 138px;
    height: 38px;
  }
  .tp-strip__pages {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
    font-size: 14px;
    line-height: 20px;
    color: var(--tp-brand-solid);
  }
  .tp-strip__sep {
    font-size: 12px;
    color: var(--tp-title);
  }

  @media (max-width: 900px) {
    .tp-strip {
      padding-top: 112px;
    }
  }
  @media (max-width: 560px) {
    .tp-strip {
      flex-direction: column;
      align-items: flex-start;
    }
    .tp-strip__pages {
      justify-content: flex-start;
    }
  }
</style>
