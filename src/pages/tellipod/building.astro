---
import TellipodLayout from '@layouts/TellipodLayout.astro';
import PageNav from '@components/tellipod/PageNav.astro';
import CtaCard from '@components/tellipod/CtaCard.astro';
import {discord, githubLink, tellipodPage} from '../../tellipod';
import wash from '@assets/tellipod/roadmap-glow-wash.svg';
import warm from '@assets/tellipod/roadmap-glow-warm.svg';
import Icon from '@components/tellipod/Icon.astro';

type Row =
  | {kind: 'info'; label: string; value: string; by?: string}
  | {kind: 'file'; title: string; meta: string};

const pods: {
  chat: {initial: string; name: string; text: string; time: string};
  icon: string;
  title: string;
  members: string;
  rows: Row[];
}[] = [
  {
    chat: {
      initial: 'M',
      name: 'Mike',
      text: 'How much Apoquel does she get?',
      time: '9:12',
    },
    icon: 'hearts',
    title: "Ginger's Care",
    members: 'You, Ana and Mike',
    rows: [
      {kind: 'info', label: 'Medication', value: 'Apoquel 16 mg · 2 times per day', by: 'A'},
      {kind: 'info', label: 'Vet', value: 'Dr. Smith · 555-0199'},
      {kind: 'info', label: 'Walks', value: 'Mike, 7 AM and 6 PM'},
    ],
  },
  {
    chat: {
      initial: 'S',
      name: 'Sam',
      text: 'Gate code is 4721. Or was it 4712?',
      time: '7:15',
    },
    icon: 'house-heart',
    title: "Mom's Apartment",
    members: 'You, Mom and Sam',
    rows: [
      {kind: 'info', label: 'Gate code', value: '4721, then #', by: 'M'},
      {kind: 'info', label: 'Wi-Fi', value: 'MomsPlace_5G · sunflower42'},
      {kind: 'info', label: 'Spare key', value: 'With Mrs. Lee, flat 3'},
    ],
  },
  {
    chat: {
      initial: 'A',
      name: 'Ana',
      text: 'Where are the passport scans?',
      time: '9:03',
    },
    icon: 'passport',
    title: 'Family Passports & Travel Docs',
    members: 'You and Ana',
    rows: [
      {kind: 'file', title: 'Passport scans', meta: '4 files'},
      {kind: 'info', label: 'Travel insurance', value: 'Valid until Aug 2027'},
      {kind: 'info', label: 'Flight to Lisbon', value: 'Jun 12 · booking K7Q2LM', by: 'A'},
    ],
  },
];

const principles = [
  {
    tag: 'Frictionless & private',
    title: "We can't read your notes, even if we wanted to",
    text: 'Everything that moves between pod members is encrypted end to end.',
  },
  {
    tag: 'Sovereign identity',
    title: 'No accounts, no passwords, no corporation',
    text: 'Your identity is a key made on your device. No company or government can take it away.',
  },
  {
    tag: 'Local-first',
    title: 'Your data stays on your devices, not in a data center',
    text: "Pods live on their members' devices and keep working when you're offline.",
  },
];
---

<TellipodLayout title="What we're building · Tellipod">
  <PageNav current="building" />

  <section class="tp-container tp-intro">
    <h1 class="tp-intro__title building__title tp-rise" style="--tp-delay: 0.05s">
      One space for each thing you do together
    </h1>
    <p class="tp-intro__lead tp-rise" style="--tp-delay: 0.1s">
      A pod is a space for one goal you're pursuing with others—caring for an aging parent, looking after a dog, planning a family trip. It holds what everyone needs to know, plus a group chat to talk it through, open only to the people involved. You decide what goes in it and who belongs, and anyone you invite, you can remove.
    </p>
  </section>

  <section class="tp-container pods" aria-label="Example pods">
    {
      pods.map((pod, i) => (
        <article class="pod tp-rise" style={`--tp-delay: ${0.15 + i * 0.08}s`}>
          <div class="said">
            <span class="initial initial--sm">{pod.chat.initial}</span>
            <div class="said__bubble">
              <p class="said__name">{pod.chat.name}</p>
              <p class="said__row">
                <span class="said__text">{pod.chat.text}</span>
                <span class="said__time">{pod.chat.time}</span>
              </p>
            </div>
          </div>

          <div class="pod-card">
            <div class="pod-card__head">
              <span class="pod-card__icon">
                <Icon name={pod.icon} />
              </span>
              <div class="pod-card__title">
                <h2>{pod.title}</h2>
                <p>{pod.members}</p>
              </div>
            </div>
            <ul class="pod-card__rows">
              {pod.rows.map((row) =>
                row.kind === 'file' ? (
                  <li class="row row--file">
                    <div class="row__text">
                      <p class="row__file-title">{row.title}</p>
                      <p class="row__file-meta">{row.meta}</p>
                    </div>
                    <Icon class="row__icon" name="chevron-right" size={16} />
                  </li>
                ) : (
                  <li class:list={['row', {'row--edit': !row.by}]}>
                    <div class="row__text">
                      <p class="row__label">{row.label}</p>
                      <p class="row__value">{row.value}</p>
                    </div>
                    {row.by ? (
                      <span class="initial initial--sm">{row.by}</span>
                    ) : (
                      <Icon class="row__icon" name="pencil" size={16} />
                    )}
                  </li>
                ),
              )}
            </ul>
          </div>
        </article>
      ))
    }
  </section>

  <section class="tp-container principles">
    <h2 class="principles__title">What that means for you</h2>
    <ul class="principles__grid">
      {
        principles.map((item) => (
          <li class="principle">
            <p class="principle__tag">{item.tag}</p>
            <div class="principle__body">
              <h3 class="principle__title">{item.title}</h3>
              <p class="principle__text">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <a class="principles__more" href={tellipodPage('words')}>
      <span class="principles__more-label">What do these words mean?</span>
    </a>
  </section>

  <section class="tp-container cta-section">
    <CtaCard wash={wash} warm={warm}>
      <div class="tp-cta__text">
        <p class="tp-hand tp-cta__ps">p.s.</p>
        <h2 class="tp-cta__title">Want to help us get there?</h2>
        <p class="tp-cta__lead">We build in the open. Read the code, report a bug, or come say hi.</p>
      </div>
      <div class="tp-cta__buttons">
        <a class="tp-btn tp-btn--brand" href={githubLink} target="_blank" rel="noopener">
          <Icon name="github" />
          <span class="tp-btn__label">Read the code on GitHub</span>
        </a>
        <a class="tp-btn tp-btn--brand" href={discord} target="_blank" rel="noopener">
          <Icon name="discord" />
          <span class="tp-btn__label">Join us on Discord</span>
        </a>
      </div>
    </CtaCard>
  </section>
</TellipodLayout>

<style>
  .building__title {
    max-width: 1024px;
  }
  .pods {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    padding-top: 40px;
    padding-bottom: 96px;
  }
  .pod {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .initial {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 9999px;
    background: var(--tp-avatar-bg);
    color: var(--tp-brand-main);
    font-size: 14px;
    line-height: 20px;
    font-weight: 700;
  }

  .said {
    display: flex;
    align-items: flex-end;
    gap: 14px;
  }
  .said .initial {
    margin-bottom: 4px;
  }
  .said__bubble {
    padding: 6px 12px;
    border: 1px solid var(--tp-hairline);
    border-radius: 10px;
    background: var(--tp-surface);
  }
  .said__name {
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
    color: var(--tp-brand-main);
  }
  .said__row {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    font-size: 16px;
    line-height: 24px;
    color: var(--tp-body);
  }
  .said__time {
    flex: none;
    font-size: 12px;
    line-height: 16px;
    color: var(--tp-muted);
  }

  .pod-card {
    display: flex;
    flex-direction: column;
    min-height: 268px;
    overflow: hidden;
    border-radius: 16px;
    background: var(--tp-surface);
    box-shadow:
      0 0 0 1px var(--tp-ring),
      0 1px 20px 1px rgba(2, 6, 23, 0.05);
  }
  .pod-card__head {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 72px;
    padding: 12px 16px 12px 12px;
    border-bottom: 1px solid var(--tp-stroke-light);
  }
  .pod-card__icon {
    display: inline-flex;
    color: var(--tp-brand-main);
    flex: none;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 9999px;
    background: var(--tp-surface-light);
  }
  .pod-card__title h2 {
    font-size: 16px;
    line-height: 24px;
    font-weight: 500;
    color: var(--tp-title);
  }
  .pod-card__title p {
    font-size: 14px;
    line-height: 20px;
    color: var(--tp-subtle);
  }
  .pod-card__rows {
    padding-inline: 16px;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-block: 12px;
    border-bottom: 1px solid var(--tp-stroke-soft);
  }
  .row:last-child {
    border-bottom: 0;
  }
  .row--edit {
    padding-right: 8px;
  }
  .row :global(.row__icon) {
    color: var(--tp-gray-solid);
  }
  .row__text {
    flex: 1 1 0;
    min-width: 0;
  }
  .row__label {
    margin-bottom: -2px;
    font-size: 12px;
    line-height: 16px;
    color: var(--tp-subtle);
  }
  .row__value {
    font-size: 16px;
    line-height: 24px;
    font-weight: 500;
    color: var(--tp-body);
  }
  .row--file {
    height: 72px;
    padding-right: 8px;
    border-bottom-color: var(--tp-stroke-light);
  }
  .row__file-title {
    font-size: 16px;
    line-height: 24px;
    font-weight: 500;
    color: var(--tp-title);
  }
  .row__file-meta {
    font-size: 14px;
    line-height: 20px;
    color: var(--tp-subtle);
  }

  .principles {
    display: flex;
    flex-direction: column;
    gap: 64px;
    padding-top: 96px;
    padding-bottom: 128px;
  }
  .principles__title {
    font-size: clamp(34px, 4vw, 48px);
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: 0.005em;
    color: var(--tp-title);
  }
  .principle {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    align-items: baseline;
    gap: 64px;
    padding-block: 32px;
    border-top: 1px solid var(--tp-stroke-light);
  }
  .principle__tag {
    font-size: 16px;
    line-height: 24px;
    font-weight: 700;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    color: var(--tp-brand-solid);
  }
  .principle__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .principle__title {
    font-size: 30px;
    line-height: 40px;
    font-weight: 600;
    letter-spacing: 0.005em;
    color: var(--tp-title);
  }
  .principle__text {
    font-size: 18px;
    line-height: 28px;
    color: var(--tp-subtle);
  }
  .principles__more {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 10px;
    font-size: 16px;
    line-height: 24px;
    color: var(--tp-brand-solid);
  }
  .principles__more-label {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .cta-section {
    padding-bottom: 128px;
  }

  @media (max-width: 1100px) {
    .pods {
      grid-template-columns: 1fr;
      max-width: 640px;
      margin-inline: auto;
    }
  }
  @media (max-width: 900px) {
    .principle {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
  @media (max-width: 760px) {
    .pods {
      padding-bottom: 56px;
    }
    .principles {
      gap: 40px;
      padding-top: 56px;
      padding-bottom: 80px;
    }
    .principle__title {
      font-size: 26px;
      line-height: 34px;
    }
    .cta-section {
      padding-bottom: 80px;
    }
  }
</style>
